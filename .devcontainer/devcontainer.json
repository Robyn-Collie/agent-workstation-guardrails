// Sandboxed workspace for a coding agent. Every setting here maps to docs/brief.md:
// non-root user, no host credentials, workspace-only mount.
{
  "name": "agent-workstation-guardrails",
  "build": { "dockerfile": "Dockerfile" },

  // The container starts as root only so its entrypoint can load the egress firewall, then
  // drops to "node" (see sandbox-entrypoint.sh). Every tool and terminal runs as "node".
  "containerUser": "root",
  "remoteUser": "node",
  // Run the image's own entrypoint instead of the CLI's default keep-alive command.
  "overrideCommand": false,

  // Mount only this repo. No "mounts" entries: nothing else from the host (no ~/.ssh,
  // ~/.aws, ~/.config, Docker socket) is visible inside.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // Drop all Linux capabilities and forbid gaining new privileges (setuid binaries like
  // sudo stop working even if someone reinstalls them). Add back only what the entrypoint
  // needs as root: NET_ADMIN to load firewall rules, SETUID and SETGID to become "node".
  // A process running as "node" has none of them.
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=no-new-privileges"
  ],

  // Hold lifecycle commands until the firewall is loaded, on first create and every restart.
  "onCreateCommand": "wait-for-egress-firewall.sh",
  "postStartCommand": "wait-for-egress-firewall.sh",

  // Project dependencies, installed inside the container, never copied from the host.
  "postCreateCommand": "npm ci && python3 -m venv .venv && .venv/bin/pip install --quiet pytest==9.1.1",
  "remoteEnv": {
    "PATH": "/workspace/.venv/bin:${containerEnv:PATH}",
    // The agent's model API key, read from the host's environment each time a command
    // starts in the container. Never "containerEnv" or a build arg: those store the value
    // in the container's or image's metadata. Set it on the host from a secret store; see
    // docs/standard.md. Empty if the host doesn't set it.
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "nrwl.angular-console",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-python.python"
      ]
    }
  }
}
