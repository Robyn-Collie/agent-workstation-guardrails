#!/bin/sh
# Shared by both hooks: run this repo's scanner against the repo being committed to.
# The scanner has no dependencies, so it runs from source with only Python 3.9+.
# Fails closed: if Python is missing, the hook refuses rather than letting code through.
hooks=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel) || exit 2
python=$(command -v python3 || true)
if [ -z "$python" ]; then
  echo "secret-scan hook: python3 not found, so the scan can't run. Install Python 3.9+." >&2
  exit 1
fi
PYTHONPATH="$hooks/../packages/secret-scan${PYTHONPATH:+:$PYTHONPATH}" \
  "$python" -m secret_scan --root "$root" "$@"
status=$?
if [ "$status" -eq 1 ]; then
  echo "secret-scan hook: blocked. Remove the secret, or if it's a test fixture, add it to .secret-scan-allowlist." >&2
fi
exit "$status"
